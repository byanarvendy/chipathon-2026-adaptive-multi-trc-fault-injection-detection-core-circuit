library (trc_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 125.0;
  nom_voltage                    : 4.50;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
  }

  cell ("trc_top") {
    area : 57848.730 
    is_macro_cell : true;
    pin("iCLK") {
      direction : input;
      clock : true;
      capacitance : 0.0435;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.35057");
	}
	cell_fall(scalar) {
          values("1.27637");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("1.36519");
	}
	cell_fall(scalar) {
          values("1.29166");
	}
      }
    }
    pin("iRST") {
      direction : input;
      capacitance : 0.0200;
    }
    pin("iSPI_CS") {
      direction : input;
      capacitance : 0.0040;
    }
    pin("iSPI_MOSI") {
      direction : input;
      capacitance : 0.0043;
    }
    pin("iSPI_SCK") {
      direction : input;
      capacitance : 0.0039;
    }
    pin("oINTERRUPT_CS") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oINTERRUPT_IE") {
      direction : output;
      capacitance : 0.0014;
    }
    pin("oINTERRUPT_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oINTERRUPT_OE") {
      direction : output;
      capacitance : 0.0016;
    }
    pin("oINTERRUPT_OUT") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "iCLK";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("12.25722,12.29731,12.40762,12.58841,12.85887,13.23874,13.73774,14.36774,15.13687,16.05474");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("0.12862,0.17324,0.32005,0.60945,1.08788,1.76888,2.66787,3.79950,5.18125,6.83588");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("11.85711,11.90072,12.02435,12.22486,12.52132,12.93244,13.47444,14.15734,14.99225,15.98634");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("0.12066,0.17147,0.32963,0.62565,1.11090,1.80781,2.73000,3.89390,5.31019,7.00058");
	}
      }
    }
    pin("oINTERRUPT_PD") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("oINTERRUPT_PU") {
      direction : output;
      capacitance : 0.0013;
    }
    pin("oINTERRUPT_SL") {
      direction : output;
      capacitance : 0.0018;
    }
    pin("oSPI_MISO_CS") {
      direction : output;
      capacitance : 0.0021;
    }
    pin("oSPI_MISO_IE") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oSPI_MISO_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oSPI_MISO_OE") {
      direction : output;
      capacitance : 0.0019;
    }
    pin("oSPI_MISO_OUT") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oSPI_MISO_PD") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oSPI_MISO_PU") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oSPI_MISO_SL") {
      direction : output;
      capacitance : 0.0008;
    }
  }

}
