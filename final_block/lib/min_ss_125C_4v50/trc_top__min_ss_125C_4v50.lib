library (trc_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 125.0;
  nom_voltage                    : 4.50;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
  }

  cell ("trc_top") {
    area : 57848.781 
    is_macro_cell : true;
    pin("iCLK") {
      direction : input;
      clock : true;
      capacitance : 0.0445;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.57338");
	}
	cell_fall(scalar) {
          values("1.52498");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("1.58525");
	}
	cell_fall(scalar) {
          values("1.53731");
	}
      }
    }
    pin("iRST") {
      direction : input;
      capacitance : 0.0065;
    }
    pin("iSPI_CS") {
      direction : input;
      capacitance : 0.0078;
    }
    pin("iSPI_MOSI") {
      direction : input;
      capacitance : 0.0043;
    }
    pin("iSPI_SCK") {
      direction : input;
      capacitance : 0.0082;
    }
    pin("oINTERRUPT_CS") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oINTERRUPT_IE") {
      direction : output;
      capacitance : 0.0014;
    }
    pin("oINTERRUPT_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oINTERRUPT_OE") {
      direction : output;
      capacitance : 0.0016;
    }
    pin("oINTERRUPT_OUT") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "iCLK";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("12.51819,12.55828,12.66859,12.84937,13.11983,13.49970,13.99870,14.62870,15.39783,16.31570");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("0.12864,0.17325,0.32006,0.60946,1.08787,1.76887,2.66787,3.79948,5.18126,6.83587");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("12.11688,12.16049,12.28412,12.48463,12.78109,13.19220,13.73420,14.41711,15.25202,16.24611");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("0.12066,0.17147,0.32963,0.62565,1.11091,1.80782,2.73000,3.89391,5.31018,7.00054");
	}
      }
    }
    pin("oINTERRUPT_PD") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("oINTERRUPT_PU") {
      direction : output;
      capacitance : 0.0013;
    }
    pin("oINTERRUPT_SL") {
      direction : output;
      capacitance : 0.0018;
    }
    pin("oSPI_MISO_CS") {
      direction : output;
      capacitance : 0.0021;
    }
    pin("oSPI_MISO_IE") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oSPI_MISO_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oSPI_MISO_OE") {
      direction : output;
      capacitance : 0.0019;
    }
    pin("oSPI_MISO_OUT") {
      direction : output;
      capacitance : 0.0028;
    }
    pin("oSPI_MISO_PD") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oSPI_MISO_PU") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oSPI_MISO_SL") {
      direction : output;
      capacitance : 0.0008;
    }
  }

}
