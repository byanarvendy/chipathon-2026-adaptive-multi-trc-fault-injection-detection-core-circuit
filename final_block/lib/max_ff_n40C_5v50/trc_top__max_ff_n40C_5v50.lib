library (trc_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 5.50;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00746,  0.03014,  0.07345,  0.14090,  0.23560,  0.36020,  0.51710,  0.70870,  0.93700");
  }

  cell ("trc_top") {
    area : 57848.730 
    is_macro_cell : true;
    pin("iCLK") {
      direction : input;
      clock : true;
      capacitance : 0.0468;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.50599");
	}
	cell_fall(scalar) {
          values("0.47000");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.51706");
	}
	cell_fall(scalar) {
          values("0.48139");
	}
      }
    }
    pin("iRST") {
      direction : input;
      capacitance : 0.0197;
    }
    pin("iSPI_CS") {
      direction : input;
      capacitance : 0.0042;
    }
    pin("iSPI_MOSI") {
      direction : input;
      capacitance : 0.0045;
    }
    pin("iSPI_SCK") {
      direction : input;
      capacitance : 0.0041;
    }
    pin("oINTERRUPT_CS") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oINTERRUPT_IE") {
      direction : output;
      capacitance : 0.0016;
    }
    pin("oINTERRUPT_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oINTERRUPT_OE") {
      direction : output;
      capacitance : 0.0018;
    }
    pin("oINTERRUPT_OUT") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "iCLK";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00746,  0.03014,  0.07345,  0.14090,  0.23560,  0.36020,  0.51710,  0.70870,  0.93700");
          values("4.09844,4.11294,4.15283,4.22073,4.32622,4.47502,4.67192,4.92081,5.22479,5.58680");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00746,  0.03014,  0.07345,  0.14090,  0.23560,  0.36020,  0.51710,  0.70870,  0.93700");
          values("0.04707,0.06380,0.11681,0.22800,0.41120,0.67041,1.01300,1.44600,1.97299,2.60200");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00746,  0.03014,  0.07345,  0.14090,  0.23560,  0.36020,  0.51710,  0.70870,  0.93700");
          values("3.99964,4.01497,4.05840,4.13152,4.24222,4.39766,4.60259,4.86143,5.17674,5.55374");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00746,  0.03014,  0.07345,  0.14090,  0.23560,  0.36020,  0.51710,  0.70870,  0.93700");
          values("0.04336,0.06109,0.11708,0.22640,0.40577,0.66329,1.00100,1.42800,1.95047,2.56808");
	}
      }
    }
    pin("oINTERRUPT_PD") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("oINTERRUPT_PU") {
      direction : output;
      capacitance : 0.0015;
    }
    pin("oINTERRUPT_SL") {
      direction : output;
      capacitance : 0.0021;
    }
    pin("oSPI_MISO_CS") {
      direction : output;
      capacitance : 0.0024;
    }
    pin("oSPI_MISO_IE") {
      direction : output;
      capacitance : 0.0025;
    }
    pin("oSPI_MISO_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oSPI_MISO_OE") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oSPI_MISO_OUT") {
      direction : output;
      capacitance : 0.0025;
    }
    pin("oSPI_MISO_PD") {
      direction : output;
      capacitance : 0.0023;
    }
    pin("oSPI_MISO_PU") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oSPI_MISO_SL") {
      direction : output;
      capacitance : 0.0009;
    }
  }

}
