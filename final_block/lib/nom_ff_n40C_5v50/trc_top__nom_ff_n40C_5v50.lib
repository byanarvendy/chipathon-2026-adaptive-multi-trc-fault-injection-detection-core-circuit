library (trc_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 5.50;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00746,  0.03014,  0.07345,  0.14090,  0.23560,  0.36020,  0.51710,  0.70870,  0.93700");
  }

  cell ("trc_top") {
    area : 57848.730 
    is_macro_cell : true;
    pin("iCLK") {
      direction : input;
      clock : true;
      capacitance : 0.0448;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.49901");
	}
	cell_fall(scalar) {
          values("0.46439");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.50915");
	}
	cell_fall(scalar) {
          values("0.47483");
	}
      }
    }
    pin("iRST") {
      direction : input;
      capacitance : 0.0196;
    }
    pin("iSPI_CS") {
      direction : input;
      capacitance : 0.0041;
    }
    pin("iSPI_MOSI") {
      direction : input;
      capacitance : 0.0044;
    }
    pin("iSPI_SCK") {
      direction : input;
      capacitance : 0.0040;
    }
    pin("oINTERRUPT_CS") {
      direction : output;
      capacitance : 0.0021;
    }
    pin("oINTERRUPT_IE") {
      direction : output;
      capacitance : 0.0015;
    }
    pin("oINTERRUPT_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oINTERRUPT_OE") {
      direction : output;
      capacitance : 0.0017;
    }
    pin("oINTERRUPT_OUT") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "iCLK";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00746,  0.03014,  0.07345,  0.14090,  0.23560,  0.36020,  0.51710,  0.70870,  0.93700");
          values("4.06380,4.07830,4.11820,4.18610,4.29159,4.44039,4.63729,4.88619,5.19017,5.55218");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00746,  0.03014,  0.07345,  0.14090,  0.23560,  0.36020,  0.51710,  0.70870,  0.93700");
          values("0.04705,0.06379,0.11681,0.22800,0.41120,0.67040,1.01300,1.44600,1.97299,2.60200");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00746,  0.03014,  0.07345,  0.14090,  0.23560,  0.36020,  0.51710,  0.70870,  0.93700");
          values("3.96130,3.97663,4.02007,4.09319,4.20389,4.35932,4.56425,4.82310,5.13841,5.51541");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00746,  0.03014,  0.07345,  0.14090,  0.23560,  0.36020,  0.51710,  0.70870,  0.93700");
          values("0.04336,0.06109,0.11708,0.22640,0.40577,0.66329,1.00100,1.42800,1.95044,2.56806");
	}
      }
    }
    pin("oINTERRUPT_PD") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("oINTERRUPT_PU") {
      direction : output;
      capacitance : 0.0014;
    }
    pin("oINTERRUPT_SL") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oSPI_MISO_CS") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oSPI_MISO_IE") {
      direction : output;
      capacitance : 0.0023;
    }
    pin("oSPI_MISO_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oSPI_MISO_OE") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oSPI_MISO_OUT") {
      direction : output;
      capacitance : 0.0024;
    }
    pin("oSPI_MISO_PD") {
      direction : output;
      capacitance : 0.0021;
    }
    pin("oSPI_MISO_PU") {
      direction : output;
      capacitance : 0.0021;
    }
    pin("oSPI_MISO_SL") {
      direction : output;
      capacitance : 0.0009;
    }
  }

}
