library (trc_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 125.0;
  nom_voltage                    : 4.50;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
  }

  cell ("trc_top") {
    area : 57848.730 
    is_macro_cell : true;
    pin("iCLK") {
      direction : input;
      clock : true;
      capacitance : 0.0471;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.38346");
	}
	cell_fall(scalar) {
          values("1.30354");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("1.40063");
	}
	cell_fall(scalar) {
          values("1.32150");
	}
      }
    }
    pin("iRST") {
      direction : input;
      capacitance : 0.0202;
    }
    pin("iSPI_CS") {
      direction : input;
      capacitance : 0.0042;
    }
    pin("iSPI_MOSI") {
      direction : input;
      capacitance : 0.0045;
    }
    pin("iSPI_SCK") {
      direction : input;
      capacitance : 0.0040;
    }
    pin("oINTERRUPT_CS") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oINTERRUPT_IE") {
      direction : output;
      capacitance : 0.0016;
    }
    pin("oINTERRUPT_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oINTERRUPT_OE") {
      direction : output;
      capacitance : 0.0018;
    }
    pin("oINTERRUPT_OUT") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "iCLK";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("12.42649,12.46658,12.57688,12.75766,13.02812,13.40799,13.90699,14.53699,15.30612,16.22399");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("0.12865,0.17326,0.32007,0.60947,1.08787,1.76887,2.66787,3.79947,5.18127,6.83587");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("12.04318,12.08679,12.21041,12.41092,12.70739,13.11849,13.66049,14.34341,15.17832,16.17241");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00764,  0.03097,  0.07551,  0.14490,  0.24230,  0.37040,  0.53180,  0.72880,  0.96370");
          values("0.12067,0.17147,0.32963,0.62564,1.11091,1.80783,2.73000,3.89391,5.31017,7.00052");
	}
      }
    }
    pin("oINTERRUPT_PD") {
      direction : output;
      capacitance : 0.0011;
    }
    pin("oINTERRUPT_PU") {
      direction : output;
      capacitance : 0.0015;
    }
    pin("oINTERRUPT_SL") {
      direction : output;
      capacitance : 0.0021;
    }
    pin("oSPI_MISO_CS") {
      direction : output;
      capacitance : 0.0024;
    }
    pin("oSPI_MISO_IE") {
      direction : output;
      capacitance : 0.0025;
    }
    pin("oSPI_MISO_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oSPI_MISO_OE") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oSPI_MISO_OUT") {
      direction : output;
      capacitance : 0.0025;
    }
    pin("oSPI_MISO_PD") {
      direction : output;
      capacitance : 0.0023;
    }
    pin("oSPI_MISO_PU") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oSPI_MISO_SL") {
      direction : output;
      capacitance : 0.0009;
    }
  }

}
