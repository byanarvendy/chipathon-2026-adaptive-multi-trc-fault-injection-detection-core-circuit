library (trc_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 5.00;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.00758,  0.03066,  0.07475,  0.14340,  0.23980,  0.36660,  0.52640,  0.72140,  0.95390");
  }

  cell ("trc_top") {
    area : 57848.781 
    is_macro_cell : true;
    pin("iCLK") {
      direction : input;
      clock : true;
      capacitance : 0.0442;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.88888");
	}
	cell_fall(scalar) {
          values("0.85682");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.89902");
	}
	cell_fall(scalar) {
          values("0.86717");
	}
      }
    }
    pin("iRST") {
      direction : input;
      capacitance : 0.0065;
    }
    pin("iSPI_CS") {
      direction : input;
      capacitance : 0.0078;
    }
    pin("iSPI_MOSI") {
      direction : input;
      capacitance : 0.0043;
    }
    pin("iSPI_SCK") {
      direction : input;
      capacitance : 0.0082;
    }
    pin("oINTERRUPT_CS") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oINTERRUPT_IE") {
      direction : output;
      capacitance : 0.0014;
    }
    pin("oINTERRUPT_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oINTERRUPT_OE") {
      direction : output;
      capacitance : 0.0016;
    }
    pin("oINTERRUPT_OUT") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "iCLK";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.00758,  0.03066,  0.07475,  0.14340,  0.23980,  0.36660,  0.52640,  0.72140,  0.95390");
          values("6.69555,6.71806,6.77983,6.88418,7.04304,7.26651,7.56192,7.93392,8.38799,8.92999");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00758,  0.03066,  0.07475,  0.14340,  0.23980,  0.36660,  0.52640,  0.72140,  0.95390");
          values("0.07284,0.09814,0.18150,0.35124,0.63069,1.02900,1.55307,2.21578,3.02378,3.98693");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.00758,  0.03066,  0.07475,  0.14340,  0.23980,  0.36660,  0.52640,  0.72140,  0.95390");
          values("6.50127,6.52577,6.59523,6.70997,6.88137,7.12089,7.43577,7.83377,8.31958,8.89877");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.00758,  0.03066,  0.07475,  0.14340,  0.23980,  0.36660,  0.52640,  0.72140,  0.95390");
          values("0.06785,0.09599,0.18526,0.35464,0.63274,1.03219,1.55919,2.22500,3.03981,4.01000");
	}
      }
    }
    pin("oINTERRUPT_PD") {
      direction : output;
      capacitance : 0.0010;
    }
    pin("oINTERRUPT_PU") {
      direction : output;
      capacitance : 0.0013;
    }
    pin("oINTERRUPT_SL") {
      direction : output;
      capacitance : 0.0018;
    }
    pin("oSPI_MISO_CS") {
      direction : output;
      capacitance : 0.0021;
    }
    pin("oSPI_MISO_IE") {
      direction : output;
      capacitance : 0.0022;
    }
    pin("oSPI_MISO_IN") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("oSPI_MISO_OE") {
      direction : output;
      capacitance : 0.0019;
    }
    pin("oSPI_MISO_OUT") {
      direction : output;
      capacitance : 0.0028;
    }
    pin("oSPI_MISO_PD") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oSPI_MISO_PU") {
      direction : output;
      capacitance : 0.0020;
    }
    pin("oSPI_MISO_SL") {
      direction : output;
      capacitance : 0.0008;
    }
  }

}
